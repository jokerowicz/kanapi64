#!/bin/bash

# $1 - name
# $2 - version

if [ -z "$1" ] || [ -z "$2" ] 
then
	echo "Run with 2 parameters:"
	echo "$0 name version"
	exit 1
fi

DIR_NAME="$1-$2"

# POPRAWKA 1: Zabezpieczenie ścieżek cudzysłowami oraz obsługa błędów mkdir/pushd
mkdir -p "${DIR_NAME}" || { echo "Failed to create directory ${DIR_NAME}"; exit 1; }
pushd "${DIR_NAME}" > /dev/null

if [ -f "../template.kanapi" ]; then
	sed "s/@NAME@/$1/g" ../template.kanapi | sed "s/@VER@/$2/g" > "$1.kanapi"
	chmod +x "$1.kanapi"
else
	echo "Error: template.kanapi not found!"
	popd > /dev/null
	exit 1
fi

popd > /dev/null

FULL_NAME="$1"
NAME="$1"

# POPRAWKA 2: Bezpieczne traktowanie zmiennych i grep
if echo "$1" | grep -q "-"; then
	NAME=$(echo "$1" | tr "-" "_")
	echo "${FULL_NAME}_ver=\$(${NAME}_ver)" >> ../../scripts/config-Makefile.kanapi
fi

echo "${NAME}_ver=$2" >> ../../scripts/config.kanapi
echo -e "\n$1:\n\t@\$(RUN_TARGET)" >> ../build/Makefile
